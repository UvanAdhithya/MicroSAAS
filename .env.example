# ── SEOSnap — Environment Variables ──────────────────────
#
# Copy to .env.local for development
# Set these in your deployment platform (Vercel → Project → Settings → Environment Variables)

# The canonical URL of your deployed site (used by sitemap, robots, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.seosnap.xyz

# ── Supabase (Auth) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://vsbvivscnbtcxvrmvytm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Database (Drizzle) — use the Supabase pooler URI (port 6543) ──
DATABASE_URL=postgresql://postgres.vsbvivscnbtcxvrmvytm:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Upstash Redis (API rate limiting) ───────────────────
# Without these, production falls back to a per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry (error monitoring) — optional; disabled when empty ──
NEXT_PUBLIC_SENTRY_DSN=
